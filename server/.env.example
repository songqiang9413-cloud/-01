# ===== 配置模板（复制成 .env 后改）=====
# 注意：.env 里含密钥，已被 .gitignore 排除，不要提交、不要外发。
# 如果部署在微信云托管（代码从 GitHub 拉取，仓库里没有 .env），
# 就把这些项配到云托管控制台的「服务设置 -> 环境变量」里，效果一样。

# ============ 复制成 .env 后按需修改（.env 不要提交到 git） ============

# 服务端口
PORT=8000

# 微信小程序（微信公众平台 -> 开发管理 -> 开发设置）
# 不填也能跑：走「开发模式」，所有用户会共用一个虚拟 openid，方便本地联调
WX_APPID=
WX_SECRET=

# 登录 token 签名密钥，线上必须改成长随机串
TOKEN_SECRET=change-me-to-a-long-random-string

# 数据看板密码（访问 /admin 时输入）
ADMIN_TOKEN=admin123

# ============ 解析服务 ============
# mock      = 演示模式：任意链接都返回内置演示视频，先把流程跑通
# selfhosted= 自建解析：不花解析费，但要自己维护（目前支持抖音，见 src/providers/selfhosted/）
# http      = 第三方解析接口：稳定省心，按次付费
#
# 直接用买来的第三方接口（大圣API），不再自建。
# 想暂时不花钱、只看流程：改成 mock（会返回内置演示视频）
PARSE_PROVIDER=http

# 主服务商失败时自动降级到它（留空 = 不降级）
# 现在只用第三方，所以留空。以后想加自建省钱，就填 selfhosted。
PARSE_FALLBACK_PROVIDER=

# 自建解析的 HTTP 超时（毫秒）
SELFHOSTED_TIMEOUT=15000

# 第三方解析接口（PARSE_PROVIDER=http 或作为兜底时生效）
# 两种常见形态：
#   1) 参数全在 URL 上的 GET 接口：PARSE_API_URL 里写 {url}，会被替换成编码后的链接
#   2) 参数在 body 里的 POST 接口：PARSE_API_URL 是固定地址，PARSE_API_BODY 里写 {url}
PARSE_API_URL=https://api.zhuceka.cn/home/api?type=dsp&uid=你的UID&key=你的KEY&url={url}
PARSE_API_METHOD=GET
# 密钥已经写在 URL 里了，所以这里留空；如果服务商要求自定义请求头，填一段 JSON
PARSE_API_HEADERS=
# 请求体模板，{url} 会被替换成用户提交的链接（GET 接口用不到，保留默认值即可）
PARSE_API_BODY={"url":"{url}"}
# 解析接口超时（毫秒）：服务商公告要求短视频设成 60 秒
PARSE_TIMEOUT=60000
# 从第三方返回的 JSON 里取值：支持 a.b.c 这种路径
PARSE_FIELD_VIDEO=data.video
PARSE_FIELD_COVER=data.cover
PARSE_FIELD_TITLE=data.title
PARSE_FIELD_AUTHOR=data.author
PARSE_FIELD_TYPE=data.type
# 图集：没有视频直链时，从这里取一组图用第 1 张兜底
PARSE_FIELD_IMAGES=data.images

# 每天免费解析次数 / 看一次广告送几次 / 每天最多看几次
# 解析免费，这是每人每天的解析次数上限（防刷接口费的保险丝，不是给用户看的门槛）
PARSE_DAILY_LIMIT=100
# 看一次激励视频广告送几次「保存到相册」
REWARD_PER_AD=10
# 领到的次数有效期（小时）：24 = 24 小时内有效
REWARD_VALID_HOURS=24
# 每人每天最多看几次广告（防刷）
MAX_REWARD_PER_DAY=10

# 资源中转是否校验签名（1=校验，防止别人拿你的服务器当免费代理）
PROXY_SIGN=1

# 中转拉上游视频的「空闲」超时（毫秒）：60 秒内没来新数据才断开
PROXY_TIMEOUT=60000

# 直连域名白名单（逗号分隔）：命中的 CDN 域名不走中转、直接给小程序，省带宽。
# 前提是这些域名也加进了微信后台的 downloadFile 合法域名。
# 域名很多时建议留空这里，改写到 server/data/direct-hosts.txt（一行一个）
PROXY_DIRECT_HOSTS=

# 本地联调时想实测中转可以打开（线上千万不要开，会被拿来做内网探测）
PROXY_ALLOW_PRIVATE=0
