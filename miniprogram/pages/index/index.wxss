.home {
  padding: 24rpx 28rpx 60rpx;
}

.hero {
  padding: 36rpx 8rpx 28rpx;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--text);
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

/* 输入卡片 */
.input-card {
  padding: 28rpx 28rpx 18rpx;
}

.url-input {
  width: 100%;
  min-height: 132rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--text);
}

.url-placeholder {
  color: #b8c0cd;
  font-size: 28rpx;
}

.input-actions {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--line);
}

.input-spacer {
  flex: 1;
}

.platform-chip {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 24rpx;
  padding: 6rpx 18rpx;
}

.action-btn {
  font-size: 26rpx;
  color: var(--text-sub);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

.action-btn-main {
  color: var(--primary);
  background: var(--primary-light);
  font-weight: 500;
}

.submit-btn {
  margin-top: 32rpx;
}

.quota-line {
  margin-top: 22rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--text-sub);
}

.quota-num {
  color: var(--primary);
  font-weight: 700;
  font-size: 30rpx;
  padding: 0 4rpx;
}

.quota-num-empty {
  color: var(--danger);
}

.quota-link {
  color: var(--primary);
  margin-left: 18rpx;
  text-decoration: underline;
}

/* 平台 */
.platforms-card,
.steps-card,
.faq-card {
  margin-top: 28rpx;
}

.platform-list {
  display: flex;
  flex-wrap: wrap;
}

.platform-item {
  font-size: 24rpx;
  color: var(--text-sub);
  background: #f3f6fd;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
}

.platform-tip {
  margin-top: 6rpx;
  line-height: 1.6;
}

/* 步骤 */
.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.step:last-child {
  margin-bottom: 0;
}

.step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  line-height: 44rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.step-body {
  flex: 1;
}

.step-title {
  font-size: 28rpx;
  font-weight: 500;
}

.step-desc {
  font-size: 24rpx;
  color: var(--text-weak);
  margin-top: 4rpx;
}

/* 广告 */
.ad-wrap {
  margin: 28rpx 0 0;
  border-radius: 20rpx;
  overflow: hidden;
}

/* FAQ */
.faq-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.faq-title {
  margin-bottom: 0;
}

.faq-arrow {
  color: var(--text-weak);
  font-size: 36rpx;
  transform: rotate(90deg);
  transition: transform 0.2s ease;
}

.faq-arrow-open {
  transform: rotate(-90deg);
}

.faq-body {
  margin-top: 22rpx;
}

.faq-item {
  margin-bottom: 22rpx;
}

.faq-item:last-child {
  margin-bottom: 0;
}

.faq-q {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--text);
}

.faq-a {
  font-size: 25rpx;
  color: var(--text-sub);
  line-height: 1.7;
  margin-top: 6rpx;
}

.copyright {
  margin-top: 28rpx;
}

.footer-link {
  text-align: center;
  color: var(--text-weak);
  font-size: 24rpx;
  padding: 40rpx 0 20rpx;
}
