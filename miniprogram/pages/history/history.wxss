.history {
  padding: 24rpx 28rpx 60rpx;
}

.list-tip {
  padding: 4rpx 8rpx 20rpx;
}

.record {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}

.record-cover {
  width: 132rpx;
  height: 132rpx;
  border-radius: 16rpx;
  background: #eef1f7;
  flex-shrink: 0;
}

.record-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-weak);
  font-size: 24rpx;
}

.record-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.record-title {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.record-meta {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.chip {
  font-size: 20rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  margin-right: 16rpx;
}

.record-del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-weak);
  padding: 16rpx 8rpx 16rpx 20rpx;
}

.clear-all {
  margin-top: 30rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
  padding: 24rpx;
}

.empty-btn {
  margin-top: 40rpx;
  width: 420rpx;
}
